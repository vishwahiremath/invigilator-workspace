{
  "manifest_version": 3,
  "name": "Invigilator Proctoring Extension",
  "version": "1.0.0",
  "description": "Companion extension for Invigilator SDK — OS lockdown, multi-screen detection, tab management, and snapshots.",
  "permissions": [
    "tabs",
    "system.display",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Invigilator Proctoring Companion"
  }
}
